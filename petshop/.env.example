# Salin nilai ini ke environment server (systemd, Docker, panel hosting, atau
# `export` di shell). Aplikasi membaca os.environ langsung; file ini TIDAK
# dibaca otomatis. Jangan commit nilai asli.

# 1 = development (default), 0 = production
DJANGO_DEBUG=0

# Wajib saat DJANGO_DEBUG=0. Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=ganti-dengan-kunci-acak-panjang

# Domain yang dilayani, pisahkan dengan koma
DJANGO_ALLOWED_HOSTS=petshop.contoh.id,localhost,127.0.0.1

# Origin HTTPS untuk form/CSRF, pisahkan dengan koma
DJANGO_CSRF_TRUSTED_ORIGINS=https://petshop.contoh.id

# Opsional: lokasi file database SQLite (default: <proyek>/db.sqlite3)
# DJANGO_DB_PATH=/var/lib/petshop/db.sqlite3

# Opsional (production): 0 bila TLS sudah di-redirect oleh reverse proxy
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=3600

