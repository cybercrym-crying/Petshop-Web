msgstr "Service '%(service_name)s' is currently unavailable."

msgid "Layanan '%(service_name)s' khusus %(t_type_display_lower)s."
msgstr "Service '%(service_name)s' is only for %(t_type_display_lower)s."

msgid "Jadwal tersebut sudah penuh. Silakan pilih jam lain."
msgstr "That slot is full. Please choose another time."

msgid "COD hanya untuk hewan yang diantar pulang kurir."
msgstr "COD is only for pets taken home by a courier."

msgid "Booking ini bukan milik Anda."
msgstr "This booking is not yours."

msgid "Booking #%(self_pk)s tidak sedang menunggu pembayaran."
msgstr "Booking #%(self_pk)s is not waiting for payment."

msgid "Booking #%(self_pk)s tidak punya bukti transfer yang menunggu dicek."
msgstr "Booking #%(self_pk)s has no transfer proof waiting to be checked."

msgid "Tulis alasan penolakan supaya pelanggan tahu yang harus diperbaiki."
msgstr "Write the reason for rejection so the customer knows what to fix."

msgid "Booking #%(self_pk)s: status %(us_self_status_label)s tidak bisa diubah ke %(tus_new_status_label)s."
msgstr "Booking #%(self_pk)s: status %(us_self_status_label)s cannot change to %(tus_new_status_label)s."

msgid "Pilih groomer terlebih dahulu."
msgstr "Choose a groomer first."

msgid "Booking #%(self_pk)s bukan tugas antar-jemput Anda."
msgstr "Booking #%(self_pk)s is not your pickup/delivery task."

msgid "Anda masih membawa %(carrying)s paket. Antar semua paket dulu sebelum antar-jemput hewan."
msgstr "You are still carrying %(carrying)s package(s). Deliver them all before a pet pickup/delivery."

msgid "Booking #%(self_pk)s sudah dikonfirmasi."
msgstr "Booking #%(self_pk)s is already confirmed."

msgid "Booking #%(self_pk)s: hewan sudah dibawa kurir, check-in dulu lalu hubungi pemilik."
msgstr "Booking #%(self_pk)s: the pet is already with the courier; check it in first, then contact the owner."

msgid "Booking #%(self_pk)s sudah berjalan, hubungi admin untuk pembatalan."
msgstr "Booking #%(self_pk)s is already in progress; contact the admin to cancel."

msgid "Booking #%(self_pk)s sudah dibayar transfer. Hubungi admin untuk pembatalan & pengembalian dana."
msgstr "Booking #%(self_pk)s was already paid by transfer. Contact the admin for cancellation and refund."

msgid "Jadwal booking #%(self_pk)s belum lewat."
msgstr "The schedule of booking #%(self_pk)s has not passed yet."

msgid "Booking #%(self_pk)s: groomer hanya bisa diganti sebelum dikerjakan."
msgstr "Booking #%(self_pk)s: the groomer can only be changed before work starts."

msgid "Booking #%(self_pk)s tidak meminta antar-jemput."
msgstr "Booking #%(self_pk)s did not request pickup/delivery."

msgid "Pilih kurir aktif untuk antar-jemput hewan."
msgstr "Choose an active courier for the pet pickup/delivery."

msgid "Booking #%(self_pk)s: kurir tidak bisa diganti saat ini."
msgstr "Booking #%(self_pk)s: the courier cannot be changed right now."

msgid "Booking #%(self_pk)s tidak meminta penjemputan."
msgstr "Booking #%(self_pk)s did not request a pickup."

msgid "Booking #%(self_pk)s belum dikonfirmasi toko."
msgstr "Booking #%(self_pk)s has not been confirmed by the store."

msgid "Booking #%(self_pk)s tidak sedang dijemput."
msgstr "Booking #%(self_pk)s is not being picked up."

msgid "QR / kode booking tidak cocok."
msgstr "The booking QR / code does not match."

msgid "Foto hewan saat dijemput wajib diambil."
msgstr "A photo of the pet at pickup is required."

msgid "Booking #%(self_pk)s: hewan belum dijemput atau sudah check-in."
msgstr "Booking #%(self_pk)s: the pet has not been picked up or is already checked in."

msgid "Booking #%(self_pk)s berstatus %(f_get_status_display)s, tidak bisa check-in."
msgstr "Booking #%(self_pk)s is %(f_get_status_display)s and cannot be checked in."

msgid "Booking #%(self_pk)s sudah ditugaskan ke groomer lain."
msgstr "Booking #%(self_pk)s is already assigned to another groomer."

msgid "Booking #%(self_pk)s bukan tugas Anda."
msgstr "Booking #%(self_pk)s is not your task."

msgid "Booking #%(self_pk)s tidak sedang dikerjakan."
msgstr "Booking #%(self_pk)s is not in progress."

msgid "Semua tahap sudah selesai."
msgstr "All steps are already done."

msgid "Tahap '%(step_name)s' wajib difoto."
msgstr "Step '%(step_name)s' requires a photo."

msgid "Booking #%(self_pk)s belum siap diambil."
msgstr "Booking #%(self_pk)s is not ready for pickup yet."

msgid "Booking #%(self_pk)s belum lunas. Terima pembayarannya dulu di Kasir (scan QR booking), baru serahkan hewan ke pemilik."
msgstr "Booking #%(self_pk)s is not paid yet. Take the payment at the Cashier first (scan the booking QR), then hand the pet to its owner."

msgid "Booking #%(self_pk)s tidak meminta diantar pulang."
msgstr "Booking #%(self_pk)s did not request a drop-off."

msgid "Booking #%(self_pk)s belum lunas. Hewan diantar pulang setelah pelanggan membayar transfer."
msgstr "Booking #%(self_pk)s is not paid yet. The pet is taken home after the customer pays by transfer."

msgid "Foto hewan saat dibawa pulang wajib diambil."
msgstr "A photo of the pet when leaving for home is required."

msgid "Booking #%(self_pk)s tidak sedang diantar pulang."
msgstr "Booking #%(self_pk)s is not on its way home."

msgid "Foto hewan saat diserahkan wajib diambil."
msgstr "A photo of the pet at handover is required."

msgid "Ulasan bisa diberikan setelah layanan selesai."
msgstr "You can review once the service is finished."

msgid "Booking ini sudah diberi ulasan."
msgstr "This booking has already been reviewed."

msgid "Pilih 1 sampai 5 bintang."
msgstr "Choose 1 to 5 stars."

msgid "Hewan ini bukan milik pelanggan tersebut."
msgstr "This pet does not belong to that customer."

msgid "Lokasi ±%(km)s km dari toko, di luar jangkauan antar-jemput (%(tore_max_delivery_km)s km)."
msgstr "The location is ±%(km)s km from the store, outside the pickup range (%(tore_max_delivery_km)s km)."

msgid "Pastikan uang tunai Rp %(self_total_price)s sudah diterima."
msgstr "Make sure the cash of Rp %(self_total_price)s has been received."

msgid "Status komplain tidak dikenal."
msgstr "Unknown complaint status."

msgid "Tulis balasan sebelum menandai komplain selesai."
msgstr "Write a reply before marking the complaint as resolved."

msgid "Setoran #%(self_pk)s sudah diterima."
msgstr "Remittance #%(self_pk)s has already been received."

msgid "Isi jumlah uang yang benar-benar diterima."
msgstr "Enter the amount actually received."

msgid "Jumlah berbeda dari tagihan: tulis catatan selisihnya."
msgstr "The amount differs from the bill: write a note about the difference."

msgid "Tidak ada uang COD yang perlu disetor."
msgstr "There is no COD money to hand in."

msgid "Kasir Anda sudah dibuka."
msgstr "Your till is already open."

msgid "Isi modal awal uang di laci (boleh 0)."
msgstr "Enter the opening cash in the drawer (0 is allowed)."

msgid "Buka kasir dulu (isi modal awal laci) sebelum menerima pembayaran."
msgstr "Open the till first (enter the opening cash) before taking payments."

msgid "Booking #%(booking_pk)s berstatus %(g_get_status_display)s: bisa dibayar setelah hewan check-in."
msgstr "Booking #%(booking_pk)s is %(g_get_status_display)s: it can be paid after the pet checks in."

msgid "Booking #%(booking_pk)s sudah dibayar (struk %(ine_order_receipt_no)s)."
msgstr "Booking #%(booking_pk)s is already paid (receipt %(ine_order_receipt_no)s)."

msgid "Booking #%(booking_pk)s sudah mengirim bukti transfer. Cek buktinya dulu di Booking Layanan."
msgstr "Booking #%(booking_pk)s already sent a transfer proof. Check it first in Service Booking."

msgid "Belum ada barang atau layanan di transaksi."
msgstr "There are no items or services in the transaction yet."

msgid "Pilih: dibawa langsung atau diantar."
msgstr "Choose: take away or deliver."

msgid "Diskon tidak boleh melebihi total belanja."
msgstr "The discount cannot exceed the total."

msgid "Tulis alasan diskon."
msgstr "Write the reason for the discount."

msgid "Diskon di atas Rp %(shier_discount_limit)s harus diberikan Admin."
msgstr "Discounts above Rp %(shier_discount_limit)s must be given by an Admin."

msgid "Nominal pembayaran tidak valid."
msgstr "Invalid payment amount."

msgid "Nominal transfer/QRIS melebihi total yang harus dibayar."
msgstr "The transfer/QRIS amount exceeds the total due."

msgid "Pastikan dana transfer/QRIS sudah masuk ke rekening toko, lalu centang konfirmasinya."
msgstr "Make sure the transfer/QRIS funds have reached the store account, then tick the confirmation."

msgid "Uang tunai kurang: harus Rp %(cash_due)s."
msgstr "Not enough cash: Rp %(cash_due)s is required."

msgid "Transaksi masih kosong, tidak ada yang diparkir."
msgstr "The transaction is empty, nothing to park."

msgid "Maksimal %(max_held_sales)s transaksi diparkir. Lanjutkan atau hapus yang lama."
msgstr "At most %(max_held_sales)s parked sales. Resume or delete an old one."

msgid "Transaksi parkir ini milik kasir lain."
msgstr "This parked sale belongs to another cashier."

msgid "Selesaikan atau parkir transaksi yang sedang berjalan dulu."
msgstr "Finish or park the current transaction first."

msgid "Pembatalan transaksi kasir hanya oleh Admin/Super Admin."
msgstr "Only an Admin/Super Admin can void a cashier transaction."

msgid "Tulis alasan pembatalan."
msgstr "Write the reason for cancelling."

msgid "Order #%(order_pk)s bukan transaksi kasir."
msgstr "Order #%(order_pk)s is not a cashier transaction."

msgid "Order #%(order_pk)s sudah dibatalkan."
msgstr "Order #%(order_pk)s is already cancelled."

msgid "Order #%(order_pk)s sedang diantar kurir; tunggu kembali ke toko."
msgstr "Order #%(order_pk)s is out with a courier; wait until it is back at the store."

msgid "Order #%(order_pk)s sudah punya retur; selesaikan lewat retur."
msgstr "Order #%(order_pk)s already has a return; settle it through the return."

msgid "Retur hanya untuk transaksi lunas yang barangnya sudah diterima."
msgstr "Returns are only for paid transactions whose items were received."

msgid "Batas retur %(current_return_days)s hari sudah lewat."
msgstr "The %(current_return_days)s-day return window has passed."

msgid "Tulis alasan retur (mis. rusak, salah ukuran)."
msgstr "Write the reason for the return (e.g. damaged, wrong size)."

msgid "Pilih cara pengembalian uang."
msgstr "Choose the refund method."

msgid "Pilih barang dan jumlah yang diretur."
msgstr "Choose the items and quantities to return."

msgid "Retur hanya bisa disetujui Admin/Super Admin."
msgstr "Only an Admin/Super Admin can approve returns."

msgid "Retur ini sudah diputuskan."
msgstr "This return has already been decided."

msgid "Untuk diantar, pilih pelanggan terdaftar (alamat & nomor HP tersimpan)."
msgstr "For delivery, choose a registered customer (saved address & phone number)."

msgid "Tidak ada barang yang perlu diantar."
msgstr "There are no items to deliver."

msgid "Alamat %(customer_name)s kosong. Lengkapi dulu di Kelola Akun."
msgstr "%(customer_name)s has no address. Complete it in Manage Account first."

msgid "Bayar saat barang sampai (COD) hanya untuk pesanan yang diantar."
msgstr "Cash on delivery (COD) is only for delivered orders."

msgid "Biaya layanan grooming dibayar di kasir; pisahkan dari pesanan COD."
msgstr "Grooming fees are paid at the cashier; keep them separate from COD orders."

msgid "'%(product_name)s' tidak dijual."
msgstr "'%(product_name)s' is not for sale."

msgid "Barang retur tidak ada di transaksi ini."
msgstr "The returned item is not in this transaction."

msgid "'%(detail_product_name)s' maksimal %(eturnable_qty_detail)s pcs yang bisa diretur."
msgstr "At most %(eturnable_qty_detail)s pcs of '%(detail_product_name)s' can be returned."

msgid "Tulis alasan penolakan."
msgstr "Write the reason for rejection."

msgid "Jumlah retur tidak valid."
msgstr "Invalid return quantity."

msgid "Gagal membuat resi unik, coba lagi."
msgstr "Could not create a unique tracking number, please try again."

msgid "Order #%(self_pk)s: status %(f_order_status_label)s tidak bisa diubah ke %(tus_new_status_label)s."
msgstr "Order #%(self_pk)s: status %(f_order_status_label)s cannot change to %(tus_new_status_label)s."

msgid "Kurir sedang antar-jemput hewan (booking #%(trip_pk)s). Paket bisa dibawa setelah tugas itu selesai."
msgstr "The courier is on a pet pickup/delivery (booking #%(trip_pk)s). Packages can be taken after that task is done."

msgid "Order #%(self_pk)s: pilih kurir terlebih dahulu."
msgstr "Order #%(self_pk)s: choose a courier first."

msgid "Order #%(self_pk)s: kurir hanya bisa ditugaskan saat order Dikonfirmasi."
msgstr "Order #%(self_pk)s: a courier can only be assigned when the order is Confirmed."

msgid "Order #%(self_pk)s: transfer harus lunas dulu sebelum kurir ditugaskan."
msgstr "Order #%(self_pk)s: the transfer must be paid before a courier is assigned."

msgid "Order #%(self_pk)s: transfer belum lunas, belum bisa dikirim."
msgstr "Order #%(self_pk)s: the transfer is not paid yet, it cannot be shipped."

msgid "Order #%(self_pk)s sudah dikonfirmasi atau diproses."
msgstr "Order #%(self_pk)s is already confirmed or processed."

msgid "Order #%(self_pk)s belum masuk antrean packing."
msgstr "Order #%(self_pk)s is not in the packing queue yet."

msgid "Order #%(self_pk)s berstatus %(f_order_status_label)s, tidak bisa diambil."
msgstr "Order #%(self_pk)s is %(f_order_status_label)s and cannot be picked up."

msgid "Order #%(self_pk)s belum siap dikirim (belum lunas / belum masuk antrean packing)."
msgstr "Order #%(self_pk)s is not ready to ship (not paid / not in the packing queue)."

msgid "Order #%(self_pk)s sudah ditugaskan ke kurir lain."
msgstr "Order #%(self_pk)s is already assigned to another courier."

msgid "Anda sudah membawa %(carrying)s paket (maks. %(limit)s per rute)."
msgstr "You are already carrying %(carrying)s package(s) (max. %(limit)s per route)."

msgid "Order #%(self_pk)s bukan paket Anda."
msgstr "Order #%(self_pk)s is not your package."

msgid "Order #%(self_pk)s tidak sedang diantar."
msgstr "Order #%(self_pk)s is not out for delivery."

msgid "QR / kode serah-terima tidak cocok dengan paket ini."
msgstr "The handover QR / code does not match this package."

msgid "Foto paket di tangan penerima wajib diambil."
msgstr "A photo of the package in the recipient's hands is required."

msgid "Pastikan uang tunai Rp %(self_total_payment)s sudah diterima."
msgstr "Make sure the cash of Rp %(self_total_payment)s has been received."

msgid "Order #%(self_pk)s tidak sedang Anda antar."
msgstr "You are not delivering order #%(self_pk)s."

msgid "Tulis kendalanya supaya admin bisa menghubungi pelanggan."
msgstr "Describe the problem so the admin can contact the customer."

msgid "Pesanan ini bukan milik Anda."
msgstr "This order is not yours."

msgid "Ulasan bisa diberikan setelah pesanan sampai."
msgstr "You can review once the order has arrived."

msgid "Pesanan ini sudah diberi ulasan."
msgstr "This order has already been reviewed."

msgid "Pesanan #%(self_pk)s tidak sedang menunggu transfer."
msgstr "Order #%(self_pk)s is not waiting for a transfer."

msgid "Order #%(self_pk)s tidak punya bukti transfer yang menunggu dicek."
msgstr "Order #%(self_pk)s has no transfer proof waiting to be checked."

msgid "Pesanan #%(self_pk)s sudah diproses toko, hubungi admin untuk pembatalan."
msgstr "Order #%(self_pk)s is already being processed; contact the admin to cancel."

msgid "Sebagian barang di keranjang sudah tidak dijual. Hapus barang tersebut dari keranjang lalu coba lagi."
msgstr "Some items in the cart are no longer for sale. Remove them from the cart and try again."

msgid "Order #%(self_pk)s sudah dibatalkan."
msgstr "Order #%(self_pk)s is already cancelled."

msgid "Belum ada item di order."
msgstr "There are no items in the order yet."

msgid "Order transfer: kurir bisa ditugaskan setelah pembayaran lunas."
msgstr "Transfer order: a courier can be assigned once payment is complete."

msgid "Shift ini sudah ditutup."
msgstr "This shift is already closed."

msgid "Isi jumlah uang tunai yang ada di laci."
msgstr "Enter the amount of cash in the drawer."

msgid "Ada selisih uang: tulis catatan penyebabnya."
msgstr "There is a cash difference: write a note on the cause."

msgid "Maksimal %(online_max_qty)s pcs per barang untuk pesanan online."
msgstr "Maximum %(online_max_qty)s pcs per item for online orders."

msgid "Alamat berjarak %(distance)s km dari toko, di luar jangkauan antar (maks. %(tore_max_delivery_km)s km)."
msgstr "The address is %(distance)s km from the store, outside the delivery range (max. %(tore_max_delivery_km)s km)."

msgid "'%(item_product_name)s' tidak dijual."
msgstr "'%(item_product_name)s' is not for sale."

msgid "Data keranjang tidak valid."
msgstr "Invalid cart data."

msgid "Order #%(order_pk)s adalah transaksi kasir: batalkan lewat halaman struk (admin, dengan alasan)."
msgstr "Order #%(order_pk)s is a cashier transaction: void it from the receipt page (admin, with a reason)."

msgid "Struk %(no)s dibatalkan"
msgstr "Receipt %(no)s voided"

msgid "Retur %(no)s"
msgstr "Return %(no)s"

msgid "Order online #%(n)s"
msgstr "Online order #%(n)s"

msgid "Order #%(n)s dibatalkan, stok dikembalikan"
msgstr "Order #%(n)s cancelled, stock restored"

msgid "Penyesuaian audit stok"
msgstr "Stock audit adjustment"

msgid "Stok awal saat produk dibuat"
msgstr "Opening stock when the product was created"

msgid "Tidak ada catatan"
msgstr "No notes"

msgid "Stok '%(name)s' tidak cukup. Stok saat ini: %(stock)s"
msgstr "Not enough stock for '%(name)s'. Current stock: %(stock)s"

msgid "Harga atau ketersediaan barang berubah sejak keranjang dibuka. Periksa kembali total terbaru lalu pesan ulang."
msgstr "Prices or availability changed since the cart was opened. Check the latest total and order again."

msgid "Tandai lokasi pengiriman di peta."
msgstr "Mark the delivery location on the map."

msgid "Pesanan sedang menunggu konfirmasi admin."
msgstr "The order is waiting for admin confirmation."

msgid "Pesanan sudah dikonfirmasi dan sedang disiapkan."
msgstr "The order is confirmed and being prepared."

msgid "Pesanan sedang diantar kurir. Posisi kurir bisa dilihat langsung di peta."
msgstr "The order is out with a courier. You can see the courier live on the map."

msgid "Pesanan sudah sampai. Foto bukti pengiriman ada di halaman lacak."
msgstr "The order has arrived. The delivery photo is on the tracking page."

msgid "Pesanan ini dibatalkan."
msgstr "This order was cancelled."

msgid "Buka halaman lacak"
msgstr "Open tracking page"

msgid "Silakan ketik pertanyaan Anda 🙂"
msgstr "Please type your question 🙂"

msgid "Sama-sama! Senang bisa membantu. 🐾"
msgstr "You're welcome! Happy to help. 🐾"

msgid "Halo! Saya asisten Seelly Petshop. Silakan pilih pertanyaan di bawah atau ketik pertanyaan Anda."
msgstr "Hi! I'm the Seelly Petshop assistant. Pick a question below or type your own."

msgid "Resi %(code)s tidak ditemukan. Periksa kembali nomor resinya ya (contoh: PS-261022-K7M2QX)."
msgstr "Tracking number %(code)s was not found. Please check the number again (example: PS-261022-K7M2QX)."

msgid "Anda juga bisa langsung chat admin di WhatsApp %(wa)s."
msgstr "You can also chat with the admin on WhatsApp %(wa)s."

msgid "Maaf, saya belum menemukan jawabannya."
msgstr "Sorry, I couldn't find the answer yet."

msgid "Status pesanan %(code)s: %(status)s."
msgstr "Order %(code)s status: %(status)s."

msgid "Mungkin maksud Anda salah satu pertanyaan di bawah?"
msgstr "Maybe you meant one of the questions below?"

msgid "Halo! 👋 Saya asisten Seelly Petshop. Pilih pertanyaan di bawah atau ketik pertanyaan Anda, misalnya “ongkir berapa?” atau nomor resi pesanan."
msgstr "Hi! 👋 I'm the Seelly Petshop assistant. Pick a question below or type your own, e.g. “how much is shipping?” or an order tracking number. Answers are written in Indonesian."

msgid "Pertanyaan itu sudah tidak tersedia."
msgstr "That question is no longer available."

msgid "Koordinat tidak valid."
msgstr "Invalid coordinates."

msgid "Tahap ini wajib foto."
msgstr "This step requires a photo."
